Within a 32 bit KVM (stable Gentoo) I run into this situation using trinity (latest git):

tfoerste@n22kvm-clone ~ $ D=/mnt/ramdisk/btrfs; while [[ : ]]; do cd ~; sudo rm -rf $D/t3 && mkdir $D/t3 || break; cd $D/t3; mkdir -p v1/v2; for i in $(seq 0 99); do touch v1/v2/f$i; mkdir v1/v2/d$i; done; trinity -C 2 -N 100000 -V $D/t3/v1/v2 -qq; echo; echo " done"; echo; sleep 4; done
mkdir: cannot create directory ‘/mnt/ramdisk/btrfs/t3’: No space left on device

tfoerste@n22kvm-clone ~ $ cd /mnt/ramdisk/btrfs

tfoerste@n22kvm-clone /mnt/ramdisk/btrfs $ ll
total 0

tfoerste@n22kvm-clone /mnt/ramdisk/btrfs $ ls -al
total 4
drwxrwxrwx 1 root root  0 Apr 29 20:38 .
drwxrwxrwt 3 root root 80 Apr 29 20:03 ..

tfoerste@n22kvm-clone /mnt/ramdisk/btrfs $ df -m .
