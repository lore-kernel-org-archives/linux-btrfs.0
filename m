> 3. set_xattr alsa-driver/alsa-kernel/isa/es1688/es1688.c - name=3Duser.=
xattr data_len=3D4 data=3Dtest
> 4. write alsa-driver/alsa-kernel/isa/es1688/es1688.c - offset=3D0, len=3D=
10458
> 5. truncate alsa-driver/alsa-kernel/isa/es1688/es1688.c size=3D10458
