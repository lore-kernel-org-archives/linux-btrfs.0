>> -
>> -	if (ret != 0) {
>> +	} else if (ret > 0) {
>>  		if (path->slots[0] == 0)
>>  			goto not_found;
>>  		path->slots[0]--;
>> @@ -6853,8 +6851,7 @@ struct extent_map *btrfs_get_extent(struct btrfs_inode *inode,
